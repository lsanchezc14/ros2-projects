<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="whisky_bot">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import whisky_bot urdf file -->
    <xacro:include filename="$(find whisky_bot_description)/urdf/whisky_bot.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="whisky_bot.ros2_control.xacro" />


    <xacro:whisky_bot_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
