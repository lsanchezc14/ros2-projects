<launch>
    <let name="urdf_path"
    value="$(find-pkg-share whisky_bot_description)/urdf/whisky_bot.urdf.xacro"/>

    <let name="rviz_config_path"
    value="$(find-pkg-share whisky_bot_description)/rviz/urdf_config.rviz"/>

    <node pkg="robot_state_publisher" exec="robot_state_publisher">
    <param name="robot_description" value="$(command 'xacro $(var urdf_path)')"/>
    </node>

    <node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui">
        <param name="zeros.joint2" value="1.57"/>
        <param name="zeros.joint4" value="1.57"/>
        <param name="zeros.joint6" value="1.57"/>
        <param name="zeros.joint8" value="1.57"/>
        <param name="zeros.joint9" value="1.57"/>
    </node>
    <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen" args="-d $(var rviz_config_path)"/>
</launch>